# Copy to .env.local and fill in what you have. Never commit real values.

# Mapbox public token (restrict it to your domains in the Mapbox dashboard)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Valyu API key: news extraction, daily brief, AI answers, research reports and explainers
VALYU_API_KEY=

# Absolute URL used in share cards, runbooks and llms.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authenticates the scheduled /api/cron/* routes (long random string)
CRON_SECRET=

# Optional: higher rate limits
GITHUB_TOKEN=
NVD_API_KEY=
